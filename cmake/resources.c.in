#include <string.h>

#define RSRC_COUNT @RESOURCE_COUNT@

#include <@TARGET_NAME@_autogen_resource_data.h>

typedef struct resource
{
    const char *name;
    const uint8_t *data;
    const uint32_t *size;
} resource_t;

static const resource_t resources[] = {
@RESOURCE_ARRAY@};

const uint8_t *@TARGET_NAME@_find_resource(const char *name, uint32_t *size)
{
    const resource_t *r;
    for (r = resources; r < resources + RSRC_COUNT; ++r)
    {
        if (!strcmp(name, r->name))
        {
            if (size)
                *size = *r->size;
            return r->data;
        }
    }
    return NULL;
}
