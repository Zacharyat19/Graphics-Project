if(NOT DEFINED RSRC_DATA_C)
    message(FATAL_ERROR "RSRC_DATA_C not defined")
endif()

if(NOT DEFINED RSRC_DATA_H)
    message(FATAL_ERROR "RSRC_DATA_H not defined")
endif()

if(NOT DEFINED RESOURCE_NAMES)
    message(FATAL_ERROR "RESOURCE_NAMES not defined")
endif()

if(NOT DEFINED RESOURCE_SOURCE_DIR)
    message(FATAL_ERROR "RESOURCE_SOURCE_DIR not defined")
endif()

file(WRITE ${RSRC_DATA_C} "/* Autogenerated by autogendata.cmake */\n")
file(APPEND ${RSRC_DATA_C} "#include <stdint.h>\n\n")

file(WRITE ${RSRC_DATA_H} "/* Autogenerated by autogendata.cmake */\n")
file(APPEND ${RSRC_DATA_H} "#include <stdint.h>\n\n")

foreach(RESOURCE_NAME ${RESOURCE_NAMES})
    set(RESOURCE_PATH ${RESOURCE_SOURCE_DIR}/${RESOURCE_NAME})
    if(NOT EXISTS ${RESOURCE_PATH})
        message(FATAL_ERROR "Could not find resource ${RESOURCE_NAME}")
    endif()

    # Get short filename
    string(REGEX MATCH "([^/]+)$" FILENAME ${RESOURCE_NAME})
    # Replace filename spaces & extension separator for C compatibility
    string(REGEX REPLACE "\\.| |-" "_" FILENAME ${FILENAME})
    # Convert to lower case
    string(TOLOWER ${FILENAME} FILENAME)
    # Read hex data from file
    file(READ ${RESOURCE_PATH} FILE_DATA HEX)
    message(STATUS "Resource: ${RESOURCE_PATH}")
    # Convert hex data for C compatibility
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," FILE_DATA ${FILE_DATA})
    # Append data to c file
    file(APPEND ${RSRC_DATA_C} "const uint8_t ${FILENAME}[] = {${FILE_DATA}};\nconst uint32_t ${FILENAME}_size = sizeof(${FILENAME});\nconst char ${FILENAME}_name[] = \"${RESOURCE_NAME}\";\n\n")
    # Append extern definitions to h file
    file(APPEND ${RSRC_DATA_H} "extern const uint8_t ${FILENAME}[];\nextern const uint32_t ${FILENAME}_size;\nextern const char ${FILENAME}_name[];\n\n")

    string(APPEND RESOURCE_ARRAY "{\"${RESOURCE_NAME}\", ${FILENAME}, &${FILENAME}_size},\n")
endforeach()
